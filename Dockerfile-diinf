# NEURONE Dockerfile - Alternative version for deploy-diinf
# Uses direct meteor build instead of meteorBuild.sh to avoid npm install issues

FROM phusion/passenger-customizable:2.0.0

# Replace shell with bash so we can source files
RUN rm /bin/sh && ln -s /bin/bash /bin/sh

# Install basic dependencies (similar to original Dockerfile)
RUN apt-get -qq update \
  && apt-get -qq --no-install-recommends install wget curl ca-certificates libarchive-tools unzip make gcc python python-dev

# Install Node.js through nvm (same as original)
ENV NVM_DIR /nvm
ENV NODE_VERSION 8.17.0
RUN mkdir -p $NVM_DIR \
  && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
RUN source $NVM_DIR/nvm.sh \
  && nvm install $NODE_VERSION \
  && nvm alias default $NODE_VERSION \
  && nvm use default
ENV NODE_PATH $NVM_DIR/v$NODE_VERSION/lib/node_modules
ENV PATH $NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH

# Set user (simplified, no need for custom user in our case)
RUN useradd -m -s /bin/bash neurone
USER neurone
ENV HOME /home/neurone

# Set working directory
RUN mkdir -p /home/neurone/app
WORKDIR /home/neurone/app

# Copy project files
COPY --chown=neurone:neurone . ./src

# Set Meteor Framework location as environment variable
ENV PATH $PATH:$HOME/.meteor

# Set Build Memory Limit
ENV TOOL_NODE_FLAGS --optimize_for_size --max_old_space_size=1536 --gc_interval=100
ENV NODE_TLS_REJECT_UNAUTHORIZED 0

# Install Meteor Framework
RUN curl https://install.meteor.com -o /tmp/install_meteor.sh \
    && sed -i.bak "s/tar -xzf.*/bsdtar -xf \"\$TARBALL_FILE\" -C \"\$INSTALL_TMPDIR\"/g" /tmp/install_meteor.sh \
    && sh /tmp/install_meteor.sh

# Alternative approach: Skip problematic npm packages and build directly
RUN cd src \
    && meteor npm install --quiet --ignore-scripts || meteor npm install --quiet --ignore-scripts --force \
    && meteor build ../neurone --directory --server-only

# Move app to final location
RUN cp -r neurone/bundle/. neurone/ \
    && rm -rf neurone/bundle

# Install production dependencies and rebuild native modules
RUN cd neurone/programs/server \
    && npm install --production --quiet --ignore-scripts \
    && npm rebuild iconv --quiet || echo "iconv rebuild failed, continuing..." \
    && npm rebuild bcrypt --quiet || echo "bcrypt rebuild failed, continuing..."

# Copy permission fix script before cleanup
RUN cp ./src/.deploy/docker/fixPermissions.sh ./fixPermissions.sh && chmod +x ./fixPermissions.sh

# Cleanup source code
RUN rm -rf src

# Switch to root temporarily to create and fix permissions on assets directory
USER root
RUN mkdir -p /home/neurone/assets
RUN ./fixPermissions.sh /home/neurone/assets neurone

# Switch back to neurone user
USER neurone

# Set environment variables
ENV NEURONE_ASSET_PATH /home/neurone/assets
ENV PORT=3000
ENV ROOT_URL=http://localhost:3000

# Expose port
EXPOSE 3000

# Set working directory to the built app
WORKDIR /home/neurone/app/neurone

# Start the app
CMD ["node", "main.js"]
