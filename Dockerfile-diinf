# NEURONE Dockerfile
# Adapted for deploy-diinf (using deployment-kit templates)

FROM node:8.17.0

# Install system dependencies required for Meteor and bsdtar
RUN apt-get update && apt-get install -y \
    curl \
    python \
    build-essential \
    libarchive-tools \
    && rm -rf /var/lib/apt/lists/*

# Create working directory
WORKDIR /app

# Copy project files
COPY . .

# Variables de entorno para build
ENV TOOL_NODE_FLAGS="--optimize_for_size --max_old_space_size=1536 --gc_interval=100"
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

# Copy and make executable the meteor build script
RUN cp ./.deploy/docker/meteorBuild.sh ./meteorBuild.sh && chmod +x ./meteorBuild.sh

# Run the meteor build script (this handles everything: install meteor, build, cleanup)
RUN ./meteorBuild.sh

# Create assets directory
RUN mkdir -p /assets

# Variables de entorno de runtime
ENV NEURONE_ASSET_PATH=/assets
ENV PORT=3000
ENV ROOT_URL=http://localhost:3000

# Expose port
EXPOSE 3000

# Volume for assets
VOLUME ["/assets"]

# Start the app
WORKDIR /app/neurone
CMD ["node", "main.js"]
